# ==============================================================================
# JasinaHub - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your Supabase configuration:
#   cp .env.example .env
#
# Obtain these values from your Supabase Dashboard:
#   https://supabase.com/dashboard -> Select Project -> Project Settings -> API
# ==============================================================================

# Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Public API Key (safe for client-side use)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Project ID / Reference ID (the subdomain in your project URL)
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Application Site URL (Used for auth redirects like password reset)
# In development: "http://localhost:8080"
# In production: "https://your-domain.com"
# If left empty, automatically detects current window.location.origin
VITE_SITE_URL="http://localhost:8080"

# (Optional) Explicit Password Reset Callback Redirect URL
# Defaults to ${VITE_SITE_URL}/update-password or ${window.location.origin}/update-password
# Ensure this URL is added under Supabase: Authentication -> URL Configuration -> Redirect URLs
VITE_RESET_PASSWORD_REDIRECT_URL="http://localhost:8080/update-password"

# ==============================================================================
# JasinaHub - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your Supabase configuration:
#   cp .env.example .env
#
# Obtain these values from your Supabase Dashboard:
#   https://supabase.com/dashboard -> Select Project -> Project Settings -> API
# ==============================================================================

# Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Public API Key (safe for client-side use)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Project ID / Reference ID (the subdomain in your project URL)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
